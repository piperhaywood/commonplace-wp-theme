<?xml version="1.0"?>
<ruleset name="Commonplace">
  <description>WordPress coding standards for the theme's own PHP.</description>
  <file>commonplace-theme</file>
  <exclude-pattern>commonplace-theme/func/related-posts-by-taxonomy/*</exclude-pattern>
  <arg name="extensions" value="php"/>
  <arg value="sp"/>
  <rule ref="WordPress-Extra">
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
  </rule>

  <!-- Composer scripts pass a tab width of 2 to override the imported WordPress default. -->
  <!-- Keep the theme's two-space indentation; retain all other WordPress checks. -->
  <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
  <rule ref="Generic.WhiteSpace.ScopeIndent">
    <properties>
      <property name="indent" value="2"/>
      <property name="tabIndent" value="false"/>
    </properties>
  </rule>
  <rule ref="WordPress.Arrays.ArrayIndentation">
    <properties>
      <property name="tabIndent" value="false"/>
    </properties>
  </rule>
  <rule ref="Universal.WhiteSpace.PrecisionAlignment">
    <properties>
      <property name="indent" value="2"/>
    </properties>
  </rule>
  <rule ref="PEAR.Functions.FunctionCallSignature">
    <properties>
      <property name="indent" value="2"/>
    </properties>
  </rule>
  <rule ref="PSR2.ControlStructures.SwitchDeclaration">
    <properties>
      <property name="indent" value="2"/>
    </properties>
  </rule>
</ruleset>
